syntax = "v1"

// ============ 用户兴趣 ============
type InterestsVO {
	Id         int64  `json:"id"`
	Interests  string `json:"interests"`
	CreateTime string `json:"createTime"`
	UpdateTime string `json:"updateTime"`
}

type SaveInterestsReq {
	Interests string `json:"interests"`
}

type OkVO {
	Success bool `json:"success"`
}

// ============ 课程搜索 ============
type CourseVO {
	Id            int64  `json:"id"`
	Name          string `json:"name"`
	CoverUrl      string `json:"coverUrl"`
	Price         int64  `json:"price"`
	Score         int64  `json:"score"`
	Sold          int64  `json:"sold"`
	Sections      int64  `json:"sections"`
	Free          int32  `json:"free"`
	CourseType    int32  `json:"courseType"`
	Enable        int32  `json:"enable"`
	CategoryIdLv1 int64  `json:"categoryIdLv1"`
	CategoryIdLv2 int64  `json:"categoryIdLv2"`
	CategoryIdLv3 int64  `json:"categoryIdLv3"`
	CreateTime    string `json:"createTime"`
	PublishTime   string `json:"publishTime"`
	Duration      int64  `json:"duration"`
}

// 按二级分类查询课程 TOP10
type CourseListVO {
	List []CourseVO `json:"list"`
}

// 课程全文检索请求
type CourseSearchReq {
	Keyword  string `form:"keyword"`
	PageNo   int64  `form:"pageNo,optional"`
	PageSize int64  `form:"pageSize,optional"`
	Sort     int32  `form:"sort,optional"` // 0 默认相关度 1 按销量 2 按评分
}

// 课程全文检索分页结果
type CourseSearchPageVO {
	Total int64      `json:"total"`
	List  []CourseVO `json:"list"`
}

type IdPathReq {
	Id int64 `path:"id"`
}

// ============ 用户兴趣（需登录） ============
@server (
	jwt:   Auth
	group: interests
)
service search-api {
	@handler SaveInterestsHandler
	put /interests (SaveInterestsReq) returns (OkVO)

	@handler GetInterestsHandler
	get /interests returns (InterestsVO)
}

// ============ 课程推荐（需登录） ============
@server (
	jwt:   Auth
	group: recommend
)
service search-api {
	// 根据二级分类id查询课程TOP10
	@handler GetTopCoursesByCategoryHandler
	get /interests/:id/courses (IdPathReq) returns (CourseListVO)
}

// ============ 课程全文检索（需登录） ============
@server (
	jwt:   Auth
	group: search
)
service search-api {
	@handler SearchCoursesHandler
	get /search/courses (CourseSearchReq) returns (CourseSearchPageVO)
}

