syntax = "v1"

// 统一分页请求
type PageRequest {
	PageNo   int64  `form:"pageNo,optional"`
	PageSize int64  `form:"pageSize,optional"`
	IsAsc    bool   `form:"isAsc,optional"`
	SortBy   string `form:"sortBy,optional"`
}

// ============== 优惠券 ==============
type CouponScopeVO {
	Id   int64  `json:"id"`
	Name string `json:"name"`
}

type CouponFormReq {
	Id                int64   `json:"id,optional"`
	Name              string  `json:"name"`
	DiscountType      string  `json:"discountType"`
	DiscountValue     int64   `json:"discountValue"`
	MaxDiscountAmount int64   `json:"maxDiscountAmount,optional"`
	ThresholdAmount   int64   `json:"thresholdAmount,optional"`
	ObtainWay         string  `json:"obtainWay"`
	Specific          bool    `json:"specific,optional"`
	Scopes            []int64 `json:"scopes,optional"`
	TotalNum          int64   `json:"totalNum,optional"`
	UserLimit         int64   `json:"userLimit,optional"`
}

type CouponIssueReq {
	Id             int64  `path:"id"`
	IssueBeginTime string `json:"issueBeginTime,optional"`
	IssueEndTime   string `json:"issueEndTime,optional"`
	TermBeginTime  string `json:"termBeginTime,optional"`
	TermDays       int64  `json:"termDays,optional"`
	TermEndTime    string `json:"termEndTime,optional"`
}

// CouponIdReq 路径参数 id（/coupons/:id 系列）
type CouponIdReq {
	Id int64 `path:"id"`
}

// CouponReceiveReq 路径参数 couponId（/user-coupons/:couponId/receive）
type CouponReceiveReq {
	CouponId int64 `path:"couponId"`
}

type CouponDetailVO {
	Id                int64           `json:"id"`
	Name              string          `json:"name"`
	DiscountType      string          `json:"discountType"`
	DiscountValue     int64           `json:"discountValue"`
	MaxDiscountAmount int64           `json:"maxDiscountAmount"`
	ThresholdAmount   int64           `json:"thresholdAmount"`
	ObtainWay         string          `json:"obtainWay"`
	Specific          bool            `json:"specific"`
	Scopes            []CouponScopeVO `json:"scopes,optional"`
	IssueBeginTime    string          `json:"issueBeginTime,optional"`
	IssueEndTime      string          `json:"issueEndTime,optional"`
	TermBeginTime     string          `json:"termBeginTime,optional"`
	TermDays          int64           `json:"termDays,optional"`
	TermEndTime       string          `json:"termEndTime,optional"`
	TotalNum          int64           `json:"totalNum"`
	UserLimit         int64           `json:"userLimit"`
	Status            string          `json:"status,optional"`
}

type CouponVO {
	Id                int64  `json:"id"`
	Name              string `json:"name"`
	DiscountType      string `json:"discountType"`
	DiscountValue     int64  `json:"discountValue"`
	MaxDiscountAmount int64  `json:"maxDiscountAmount"`
	ThresholdAmount   int64  `json:"thresholdAmount"`
	Specific          bool   `json:"specific"`
	TermDays          int64  `json:"termDays,optional"`
	TermEndTime       string `json:"termEndTime,optional"`
	Available         bool   `json:"available,optional"`
	Received          bool   `json:"received,optional"`
}

type CouponPageVO {
	Id                int64  `json:"id"`
	Name              string `json:"name"`
	DiscountType      string `json:"discountType"`
	DiscountValue     int64  `json:"discountValue"`
	MaxDiscountAmount int64  `json:"maxDiscountAmount"`
	ThresholdAmount   int64  `json:"thresholdAmount"`
	Specific          bool   `json:"specific"`
	ObtainWay         string `json:"obtainWay"`
	TotalNum          int64  `json:"totalNum"`
	IssueNum          int64  `json:"issueNum"`
	UsedNum           int64  `json:"usedNum"`
	Status            string `json:"status"`
	TermDays          int64  `json:"termDays,optional"`
	TermBeginTime     string `json:"termBeginTime,optional"`
	TermEndTime       string `json:"termEndTime,optional"`
	IssueBeginTime    string `json:"issueBeginTime,optional"`
	IssueEndTime      string `json:"issueEndTime,optional"`
	CreateTime        string `json:"createTime,optional"`
}

type CouponPageReq {
	PageRequest
	Name   string `form:"name,optional"`
	Status string `form:"status,optional"`
	Type   string `form:"type,optional"`
}

type CouponPageResp {
	List  []CouponPageVO `json:"list"`
	Total int64          `json:"total"`
	Pages int64          `json:"pages"`
}

type CouponListResp {
	List []CouponVO `json:"list"`
}

// ============== 折扣计算 ==============
type CouponDiscountVO {
	DiscountAmount int64            `json:"discountAmount"`
	DiscountDetail map[string]int64 `json:"discountDetail,optional"`
	Ids            []int64          `json:"ids,optional"`
	Rules          []string         `json:"rules,optional"`
}

type OrderCourseItem {
	CateId int64 `json:"cateId,optional"`
	Id     int64 `json:"id"`
	Price  int64 `json:"price"`
}

// UserCouponAvailableReq 订单课程列表。
// 说明：goctl 不支持顶层数组请求体（request body must be struct），
// 故按项目既有约定（course 服务同款）包一层 courseList。
type UserCouponAvailableReq {
	CourseList []OrderCourseItem `json:"courseList"`
}

type OrderCouponReq {
	CourseList    []OrderCourseItem `json:"courseList"`
	UserCouponIds []int64           `json:"userCouponIds,optional"`
}

type CouponDiscountListResp {
	List []CouponDiscountVO `json:"list"`
}

// ============== 用户优惠券 ==============
type UserCouponPageReq {
	PageRequest
	Status string `form:"status,optional"`
}

type UserCouponPageResp {
	List  []CouponVO `json:"list"`
	Total int64      `json:"total"`
	Pages int64      `json:"pages"`
}

// CouponIdsReq 用户券 id 列表，query 形式：?couponIds=1&couponIds=2
type CouponIdsReq {
	CouponIds []int64 `form:"couponIds"`
	OrderId   int64   `form:"orderId,optional"`
}

type RulesResp {
	Rules []string `json:"rules"`
}

type ExchangeByCodeReq {
	Code string `path:"code"`
}

// ============== 兑换码 ==============
type ExchangeCodeVO {
	Id   int64  `json:"id"`
	Code string `json:"code"`
}

type CouponCodePageReq {
	PageRequest
	CouponId int64  `form:"couponId,optional"`
	Status   string `form:"status,optional"`
}

type CouponCodePageResp {
	List  []ExchangeCodeVO `json:"list"`
	Total int64            `json:"total"`
	Pages int64            `json:"pages"`
}

// ============== 服务 ==============
@server (
	jwt: Auth
)
service promotion-api {
	// 优惠券管理
	@handler CouponCreateHandler
	post /coupons (CouponFormReq) returns (CouponDetailVO)

	@handler CouponListHandler
	get /coupons/list returns (CouponListResp)

	@handler CouponPageHandler
	get /coupons/page (CouponPageReq) returns (CouponPageResp)

	@handler CouponGetHandler
	get /coupons/:id (CouponIdReq) returns (CouponDetailVO)

	@handler CouponDeleteHandler
	delete /coupons/:id (CouponIdReq)

	@handler CouponIssueHandler
	put /coupons/:id/issue (CouponIssueReq)

	@handler CouponPauseHandler
	put /coupons/:id/pause (CouponIdReq)

	// 用户优惠券
	@handler UserCouponAvailableHandler
	post /user-coupons/available (UserCouponAvailableReq) returns (CouponDiscountListResp)

	@handler UserCouponDiscountHandler
	post /user-coupons/discount (OrderCouponReq) returns (CouponDiscountVO)

	@handler UserCouponPageHandler
	get /user-coupons/page (UserCouponPageReq) returns (UserCouponPageResp)

	@handler UserCouponRefundHandler
	put /user-coupons/refund (CouponIdsReq)

	@handler UserCouponRulesHandler
	get /user-coupons/rules (CouponIdsReq) returns (RulesResp)

	@handler UserCouponUseHandler
	put /user-coupons/use (CouponIdsReq)

	@handler UserCouponExchangeHandler
	post /user-coupons/:code/exchange (ExchangeByCodeReq)

	@handler UserCouponReceiveHandler
	post /user-coupons/:couponId/receive (CouponReceiveReq)

	// 兑换码
	@handler CouponCodePageHandler
	get /codes/page (CouponCodePageReq) returns (CouponCodePageResp)
}

