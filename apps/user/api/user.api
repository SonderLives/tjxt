syntax = "v1"

// 统一分页请求
type PageRequest {
	PageNo   int64  `form:"pageNo,optional"`
	PageSize int64  `form:"pageSize,optional"`
	IsAsc    bool   `form:"isAsc,optional"`
	SortBy   string `form:"sortBy,optional"`
}

// ============ 账户 ============
type LoginReq {
	Username  string `json:"username,optional"` // 员工登录用用户名
	CellPhone string `json:"cellPhone,optional"` // 学员/老师登录用手机号
	Password  string `json:"password"`
	Type      int32  `json:"type"` // 1-员工, 2-学员, 3-老师
}

type LoginVO {
	UserId       int64  `json:"userId"`
	Username     string `json:"username"`
	CellPhone    string `json:"cellPhone"`
	Type         int32  `json:"type"`
	Token        string `json:"token"`
	RefreshToken string `json:"refreshToken"`
	ExpireTime   int64  `json:"expireTime"`
}

type RegisterReq {
	CellPhone string `json:"cellPhone"` // 学员手机号注册，密码由服务自动生成
}

type RegisterVO {
	UserId    int64  `json:"userId"`
	CellPhone string `json:"cellPhone"`
}

type RefreshReq {
	RefreshToken string `json:"refreshToken"`
}

// ============ 用户信息 ============
type UserVO {
	Id         int64  `json:"id"`
	Username   string `json:"username"`
	CellPhone  string `json:"cellPhone"`
	Type       int32  `json:"type"`
	Status     int32  `json:"status"`
	Name       string `json:"name"`
	Gender     int32  `json:"gender"`
	Icon       string `json:"icon"`
	Email      string `json:"email"`
	Photo      string `json:"photo"`
	RoleId     int64  `json:"roleId"`
	DepId      int64  `json:"depId"`
	Job        string `json:"job"`
	Intro      string `json:"intro"`
	CreateTime string `json:"createTime"`
}

type UpdateUserReq {
	Name   string `json:"name,optional"`
	Gender int32  `json:"gender,optional"`
	Icon   string `json:"icon,optional"`
	Email  string `json:"email,optional"`
	Photo  string `json:"photo,optional"`
	Intro  string `json:"intro,optional"`
	Job    string `json:"job,optional"`
}

type UserPageVO {
	Total int64    `json:"total"`
	Pages int64    `json:"pages"`
	List  []UserVO `json:"list"`
}

// 占位返回（无业务字段）
type OkVO {
	Success bool `json:"success"`
}

// ============ 公开接口（账户/注册） ============
@server (
	group: account
)
service user-api {
	@handler LoginHandler
	post /accounts/login (LoginReq) returns (LoginVO)

	@handler RefreshTokenHandler
	post /accounts/refresh (RefreshReq) returns (LoginVO)

	@handler RegisterStudentHandler
	post /students/register (RegisterReq) returns (RegisterVO)
}

// ============ 需登录接口（当前用户） ============
@server (
	jwt:   Auth
	group: user
)
service user-api {
	@handler GetCurrentHandler
	get /users/me returns (UserVO)

	@handler UpdateCurrentUserHandler
	put /users (UpdateUserReq) returns (OkVO)
}

// ============ 管理后台分页查询（需登录） ============
@server (
	jwt:   Auth
	group: admin
)
service user-api {
	@handler PageStudentsHandler
	get /students (PageRequest) returns (UserPageVO)

	@handler PageTeachersHandler
	get /teachers (PageRequest) returns (UserPageVO)

	@handler PageStaffsHandler
	get /staffs (PageRequest) returns (UserPageVO)
}

