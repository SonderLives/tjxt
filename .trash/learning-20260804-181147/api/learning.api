syntax = "v1"

type PageRequest {
	PageNo   int64 `form:"pageNo,omitempty"`
	PageSize int64 `form:"pageSize,omitempty"`
	IsAsc    bool  `form:"isAsc,omitempty"`
}

type LessonRequest {
	CourseId int64 `path:"courseId"`
}

type PlanRequest {
	CourseId int64 `json:"courseId"`
	Freq     int64 `json:"freq"`
}

type Lesson {
	Id              int64  `json:"id"`
	CourseId        int64  `json:"courseId"`
	Status          int64  `json:"status"`
	WeekFreq        int64  `json:"weekFreq"`
	PlanStatus      int64  `json:"planStatus"`
	LearnedSections int64  `json:"learnedSections"`
	CreateTime      string `json:"createTime"`
	ExpireTime      string `json:"expireTime,omitempty"`
}

type LessonPage {
	List  []Lesson `json:"list"`
	Total int64    `json:"total"`
	Pages int64    `json:"pages"`
}

type Result {
	Code      int64  `json:"code"`
	Msg       string `json:"msg"`
	RequestId string `json:"requestId"`
	Data      string `json:"data"`
}

@server (
	jwt: Auth
)
service learning-api {
	@handler CurrentLessonHandler
	get /lessons/now returns (Result)

	@handler PageLessonsHandler
	get /lessons/page (PageRequest) returns (Result)

	@handler PagePlansHandler
	get /lessons/plans (PageRequest) returns (Result)

	@handler CreatePlanHandler
	post /lessons/plans (PlanRequest) returns (Result)

	@handler GetLessonHandler
	get /lessons/:courseId (LessonRequest) returns (Result)

	@handler DeleteLessonHandler
	delete /lessons/:courseId (LessonRequest) returns (Result)

	@handler CountLessonsHandler
	get /lessons/:courseId/count (LessonRequest) returns (Result)

	@handler ValidateLessonHandler
	get /lessons/:courseId/valid (LessonRequest) returns (Result)
}

