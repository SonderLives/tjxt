syntax = "v1"

// ============ 认证（auth 域） ============

type LoginFormDTO {
	CellPhone  string `json:"cellPhone,omitempty"`
	Username   string `json:"username,omitempty"`
	Password   string `json:"password"`
	Type       int64  `json:"type"`
	RememberMe bool   `json:"rememberMe,omitempty"`
}

type RefreshReq {
}

// ============ 学员 ============

type StudentFormDTO {
	CellPhone string `json:"cellPhone"`
	Code      string `json:"code,omitempty"`
	Password  string `json:"password"`
}

type StudentPageReq {
	PageNo   int64  `form:"pageNo,omitempty"`
	PageSize int64  `form:"pageSize,omitempty"`
	IsAsc    bool   `form:"isAsc,omitempty"`
	SortBy   string `form:"sortBy,omitempty"`
	Name     string `form:"name,omitempty"`
	Phone    string `form:"phone,omitempty"`
	Status   int64  `form:"status,omitempty"`
}

// ============ 用户 ============

type UserDTO {
	Id        int64  `json:"id,omitempty"`
	Username  string `json:"username,omitempty"`
	CellPhone string `json:"cellPhone,omitempty"`
	Name      string `json:"name,omitempty"`
	Gender    int64  `json:"gender,omitempty"`
	Icon      string `json:"icon,omitempty"`
	Email     string `json:"email,omitempty"`
	Qq        string `json:"qq,omitempty"`
	Job       string `json:"job,omitempty"`
	Province  string `json:"province,omitempty"`
	City      string `json:"city,omitempty"`
	District  string `json:"district,omitempty"`
	Intro     string `json:"intro,omitempty"`
	Photo     string `json:"photo,omitempty"`
	RoleId    int64  `json:"roleId,omitempty"`
	Type      int64  `json:"type,omitempty"`
}

type UserFormDTO {
	UserDTO
	OldPassword string `json:"oldPassword,omitempty"`
	Password    string `json:"password,omitempty"`
}

type UserIdReq {
	Id int64 `path:"id"`
}

type UserStatusReq {
	Id     int64 `path:"id"`
	Status int64 `path:"status"`
}

type UserCheckCellphoneReq {
	Cellphone string `form:"cellphone"`
}

type UserPageReq {
	StudentPageReq
}

@server (
	jwt: Auth
)
service user-api {
	// 认证（登录无需 token，其余需登录）
	@handler AccountLoginHandler
	post /accounts/login (LoginFormDTO) returns (string)

	@handler AdminLoginHandler
	post /accounts/admin/login (LoginFormDTO) returns (string)

	@handler AccountRefreshHandler
	get /accounts/refresh returns (string)

	@handler AccountLogoutHandler
	post /accounts/logout returns (string)

	// 学员
	@handler StudentRegisterHandler
	post /students/register (StudentFormDTO) returns (string)

	@handler StudentPasswordHandler
	put /students/password (StudentFormDTO) returns (string)

	@handler StudentPageHandler
	get /students/page (StudentPageReq) returns (string)

	// 教师
	@handler TeacherPageHandler
	get /teachers/page (StudentPageReq) returns (string)

	// 员工
	@handler StaffPageHandler
	get /staffs/page (StudentPageReq) returns (string)

	// 用户
	@handler UserMeHandler
	get /users/me returns (string)

	@handler UserCreateHandler
	post /users (UserDTO) returns (string)

	@handler UserUpdateHandler
	put /users (UserFormDTO) returns (string)

	@handler UserCheckCellphoneHandler
	get /users/checkCellphone (UserCheckCellphoneReq) returns (string)

	@handler UserGetHandler
	get /users/:id (UserIdReq) returns (string)

	@handler UserAdminUpdateHandler
	put /users/:id (UserDTO) returns (string)

	@handler UserResetPasswordHandler
	put /users/:id/password/default (UserIdReq) returns (string)

	@handler UserStatusHandler
	put /users/:id/status/:status (UserStatusReq) returns (string)
}
