syntax = "v1"

// 统一分页请求
type PageRequest {
	PageNo   int64  `form:"pageNo,omitempty"`
	PageSize int64  `form:"pageSize,omitempty"`
	IsAsc    bool   `form:"isAsc,omitempty"`
	SortBy   string `form:"sortBy,omitempty"`
}

// ============ 购物车 ============

type CartsAddReq {
	CourseId int64 `json:"courseId"`
}

type CartsDeleteReq {
	Ids string `form:"ids"`
}

// ============ 订单 ============

type PrePlaceOrderReq {
	CourseIds string `form:"courseIds"`
}

type PlaceOrderReq {
	OrderId   int64   `json:"orderId"`
	CourseIds []int64 `json:"courseIds"`
	CouponIds []int64 `json:"couponIds,omitempty"`
}

type FreeCourseReq {
	CourseId int64 `path:"courseId"`
}

type OrderPageReq {
	PageRequest
	Status int64 `form:"status,omitempty"`
}

type OrderIdReq {
	Id int64 `path:"id"`
}

// ============ 订单明细 ============

type OrderDetailCourseReq {
	Id int64 `path:"id"`
}

type EnrollCourseReq {
	StudentIds string `form:"studentIds"`
}

type EnrollNumReq {
	CourseIdList string `form:"courseIdList"`
}

type OrderDetailPageReq {
	PageRequest
	Id            int64  `form:"id,omitempty"`
	Mobile        string `form:"mobile,omitempty"`
	Status        int64  `form:"status,omitempty"`
	RefundStatus  int64  `form:"refundStatus,omitempty"`
	PayChannel    string `form:"payChannel,omitempty"`
	OrderStartTime string `form:"orderStartTime,omitempty"`
	OrderEndTime   string `form:"orderEndTime,omitempty"`
}

type PurchaseInfoReq {
	CourseId int64 `form:"courseId"`
}

// ============ 支付 ============

type PayApplyReq {
	OrderId        int64  `json:"orderId"`
	PayChannelCode string `json:"payChannelCode"`
}

// ============ 退款 ============

type RefundApplyReq {
	OrderDetailId int64  `json:"orderDetailId"`
	RefundReason  string `json:"refundReason"`
	QuestionDesc  string `json:"questionDesc,omitempty"`
}

type ApproveReq {
	Id             int64  `json:"id"`
	ApproveType    int64  `json:"approveType"`
	ApproveOpinion string `json:"approveOpinion,omitempty"`
	Remark         string `json:"remark,omitempty"`
}

type RefundCancelReq {
	Id            int64 `json:"id"`
	OrderDetailId int64 `json:"orderDetailId"`
}

type RefundApplyPageReq {
	PageRequest
	Id              int64  `form:"id,omitempty"`
	Mobile          string `form:"mobile,omitempty"`
	OrderId         int64  `form:"orderId,omitempty"`
	OrderDetailId   int64  `form:"orderDetailId,omitempty"`
	RefundStatus    int64  `form:"refundStatus,omitempty"`
	ApplyStartTime  string `form:"applyStartTime,omitempty"`
	ApplyEndTime    string `form:"applyEndTime,omitempty"`
}

type RefundIdReq {
	Id int64 `path:"id"`
}

@server (
	jwt: Auth
)
service trade-api {
	// 购物车
	@handler CartListHandler
	get /carts returns (PageRequest)

	@handler CartAddHandler
	post /carts (CartsAddReq) returns (PageRequest)

	@handler CartDeleteHandler
	delete /carts (CartsDeleteReq) returns (PageRequest)

	// 订单
	@handler PrePlaceOrderHandler
	get /orders/prePlaceOrder (PrePlaceOrderReq) returns (PageRequest)

	@handler PlaceOrderHandler
	post /orders/placeOrder (PlaceOrderReq) returns (PageRequest)

	@handler FreeCourseHandler
	post /orders/freeCourse/:courseId (FreeCourseReq) returns (PageRequest)

	@handler OrderPageHandler
	get /orders/page (OrderPageReq) returns (PageRequest)

	@handler OrderDetailHandler
	get /orders/:id (OrderIdReq) returns (PageRequest)

	@handler DeleteOrderHandler
	delete /orders/:id (OrderIdReq) returns (PageRequest)

	@handler CancelOrderHandler
	put /orders/:id/cancel (OrderIdReq) returns (PageRequest)

	@handler OrderStatusHandler
	get /orders/:id/status (OrderIdReq) returns (PageRequest)

	// 订单明细
	@handler OrderDetailCourseHandler
	get /order-details/course/:id (OrderDetailCourseReq) returns (PageRequest)

	@handler EnrollCourseHandler
	get /order-details/enrollCourse (EnrollCourseReq) returns (PageRequest)

	@handler EnrollNumHandler
	get /order-details/enrollNum (EnrollNumReq) returns (PageRequest)

	@handler OrderDetailPageHandler
	get /order-details/page (OrderDetailPageReq) returns (PageRequest)

	@handler PurchaseInfoHandler
	get /order-details/purchaseInfo (PurchaseInfoReq) returns (PageRequest)

	@handler OrderDetailGetHandler
	get /order-details/:id (OrderIdReq) returns (PageRequest)

	// 支付
	@handler PayChannelsHandler
	get /pay/channels returns (PageRequest)

	@handler PayOrderHandler
	post /pay/order (PayApplyReq) returns (PageRequest)

	// 退款
	@handler RefundApplyCreateHandler
	post /refund-apply (RefundApplyReq) returns (PageRequest)

	@handler RefundApplyApproveHandler
	put /refund-apply/approval (ApproveReq) returns (PageRequest)

	@handler RefundApplyCancelHandler
	put /refund-apply/cancel (RefundCancelReq) returns (PageRequest)

	@handler RefundApplyDetailHandler
	get /refund-apply/detail/:id (RefundIdReq) returns (PageRequest)

	@handler RefundApplyNextHandler
	get /refund-apply/next returns (PageRequest)

	@handler RefundApplyPageHandler
	get /refund-apply/page (RefundApplyPageReq) returns (PageRequest)

	@handler RefundApplyGetHandler
	get /refund-apply/:id (RefundIdReq) returns (PageRequest)
}
